# ═══════════════════════════════════════════════════════════════════════════
# ARIA — plantilla de variables de entorno
# ═══════════════════════════════════════════════════════════════════════════
# NUNCA se commitea el .env real (lo bloquea .gitignore). Copia lo que
# necesites de aquí con valores reales.
#
# En PRODUCCIÓN (docker-compose.prod.yml) hay DOS ficheros:
#
#   ./.env            → variables de este bloque "COMPOSE" (las lee compose
#                       para sustituir ${...} en docker-compose.prod.yml)
#   ./backend/.env    → variables del bloque "BACKEND" (se inyectan en el
#                       contenedor backend vía env_file; los secretos van aquí)
#
# El compose SOBRESCRIBE DATABASE_URL / REDIS_URL / CHROMA_HOST / CHROMA_PORT /
# OLLAMA_BASE_URL / ENVIRONMENT / FRONTEND_URL con la topología de la red de
# contenedores, así que en backend/.env esos valores dan igual (pueden quedar
# con los de desarrollo local).
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────── COMPOSE  (→ ./.env) ───────────────────────────

# Dominio público. VACÍO = Caddy sirve en :80 SIN TLS (modo interino, mientras
# el DNS del dominio no apunte todavía a la IP de la VM). Con un valor
# (p. ej. aria.midominio.me) Caddy provisiona HTTPS automático de Let's Encrypt.
DOMAIN=

# URL/IP pública por la que se accede a ARIA. Se usa para el CORS del backend.
# Sin dominio todavía:
PUBLIC_APP_URL=http://9.160.105.198
# Con dominio (ejemplo):
# PUBLIC_APP_URL=https://aria.midominio.me

# Contraseña de PostgreSQL en el contenedor (la BD no se expone a Internet).
POSTGRES_PASSWORD=cambia_esta_password

# Clave de cifrado de credenciales de n8n. Genera una aleatoria, p. ej.:
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=genera_una_clave_hex_aleatoria


# ─────────────────────────── BACKEND  (→ ./backend/.env) ───────────────────

# --- LLMs (obligatorias) -------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here          # Gemini (LLM primario + visión)
GROQ_API_KEY=your_groq_api_key_here              # Groq (LLM 3er fallback + Whisper)
TAVILY_API_KEY=your_tavily_api_key_here          # búsqueda web (fallback RAG)
OPENAI_API_KEY=your_openai_api_key_here          # fallback adicional

# --- Voz (opcionales) --------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- GitHub (opcional, para MCP) --------------------------------------
GITHUB_TOKEN=your_github_token_here

# --- Infra: en producción los sobrescribe docker-compose.prod.yml -----
DATABASE_URL=postgresql+asyncpg://aria:aria@postgres:5432/aria_db
REDIS_URL=redis://redis:6379
CHROMA_HOST=chromadb
CHROMA_PORT=8000
OLLAMA_BASE_URL=http://ollama:11434

# --- App -------------------------------------------------------------
ENVIRONMENT=production                            # development | production
FRONTEND_URL=http://localhost:3000               # (prod: lo pone el compose = PUBLIC_APP_URL)
BACKEND_URL=http://localhost:8000                # (prod: lo pone el compose = PUBLIC_APP_URL)

# --- Integraciones -------------------------------------------------
DATADOG_WEBHOOK_SECRET=aria_webhook_secret_2024
N8N_WEBHOOK_URL=http://n8n:5678/webhook/aria     # URL del webhook del flujo n8n

# --- Pendiente (CONTEXTO_ARIA_TFM.md §12.2) --------------------------
# El enlace del dashboard en la notificación a n8n/Telegram está HARDCODEADO a
# http://localhost:3000/... en backend/api/routes/webhooks.py (_send_n8n_notification).
# Esta variable queda documentada aquí para cuando se haga la corrección de código;
# HOY el backend todavía NO la lee.
PUBLIC_APP_URL=http://9.160.105.198
