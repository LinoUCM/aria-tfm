# ─── LLM ────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here        # fallback + Whisper

# ─── VOICE ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here            # Whisper gratis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ─── SEARCH ─────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here        # Web search gratis

# ─── GITHUB ─────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here            # Para MCP GitHub

# ─── DATABASE ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aria:aria@postgres:5432/aria_db
REDIS_URL=redis://redis:6379

# ─── CHROMADB ───────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_COLLECTION=aria_knowledge_base

# ─── STORAGE (producción) ───────────────────────────────
# Cloudflare R2 (gratis hasta 10GB)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=aria-uploads

# ─── APP ─────────────────────────────────────────────────
ENVIRONMENT=development                         # development | production
SECRET_KEY=change_this_to_a_random_secret_key
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── DATADOG SIMULATOR ───────────────────────────────────
DATADOG_WEBHOOK_SECRET=aria_webhook_secret_2024
